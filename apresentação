-- ================================================================
-- SEÇÃO 2 -- FUNÇÕES DE AGREGAÇÃO (COUNT, SUM, MAX, MIN, AVG)
-- ================================================================
-- O que falar na apresentação: "Utilizamos as funções de agregação para resumir 
-- o volume do estoque: COUNT conta a variedade de itens, SUM soma o total de peças físicas, 
-- MAX/MIN identificam os lotes extremos, e AVG tira a média de unidades por lote."

SELECT 
    COUNT(*) AS total_itens_estoque,
    SUM(quantidade) AS quantidade_total_pecas,
    MAX(quantidade) AS maior_lote,
    MIN(quantidade) AS menor_lote,
    ROUND(AVG(quantidade), 2) AS media_por_lote
FROM estoque;


-- ================================================================
-- SEÇÃO 3 -- GROUP BY e HAVING
-- ================================================================
-- O que falar na apresentação: "O GROUP BY agrupa os dados por categoria de produto, 
-- e o HAVING atua como um filtro pós-agregação, exibindo apenas as categorias 
-- que possuem um volume total acumulado superior a 5 unidades."

SELECT 
    c.nome_categoria, 
    COUNT(e.id_item) AS total_produtos,
    SUM(e.quantidade) AS quantidade_total
FROM estoque e
JOIN categorias c ON e.id_categoria = c.id_categoria
GROUP BY c.nome_categoria
HAVING SUM(e.quantidade) > 5;


-- ================================================================
-- SEÇÃO 4 -- OPERADORES DE CONJUNTO (UNION / UNION ALL)
-- ================================================================
-- O que falar na apresentação: "O operador UNION une os resultados de duas consultas 
-- estruturalmente iguais (Alimentos e Vestuário) em uma única listagem limpa, 
-- eliminando duplicatas automaticamente."

SELECT nome_item, quantidade, 'Alimentos' AS setor FROM estoque WHERE id_categoria = 1
UNION
SELECT nome_item, quantidade, 'Vestuário' AS setor FROM estoque WHERE id_categoria = 2;


-- ================================================================
-- SEÇÃO 5 -- DISTINCT, IN, EXISTS e NOT EXISTS
-- ================================================================

-- a) DISTINCT: Remove repetições para listar apenas as categorias ativas no estoque
SELECT DISTINCT c.nome_categoria 
FROM categorias c 
JOIN estoque e ON c.id_categoria = e.id_categoria;

-- b) IN: Filtra itens pertencentes especificamente às categorias 1 (Alimentos) ou 3 (Higiene)
SELECT * FROM estoque 
WHERE id_categoria IN (1, 3);

-- c) EXISTS: Verifica de forma otimizada quais doadores possuem doações ativas registradas
SELECT * FROM doadores d
WHERE EXISTS (
    SELECT 1 FROM doacoes doacao WHERE doacao.id_doador = d.id_doador
);

-- d) NOT EXISTS: Identifica doadores cadastrados que nunca realizaram nenhuma doação (inativos)
SELECT * FROM doadores d
WHERE NOT EXISTS (
    SELECT 1 FROM doacoes doacao WHERE doacao.id_doador = d.id_doador
);


-- ================================================================
-- SEÇÃO 6 -- ÍNDICES E SHOW INDEX
-- ================================================================
-- O que falar na apresentação: "Criamos um índice na coluna nome_item para evitar 
-- a varredura sequencial (Full Table Scan) e acelerar as buscas na tabela de estoque."

CREATE INDEX idx_estoque_nome ON estoque(nome_item);

SHOW INDEX FROM estoque;


-- ================================================================
-- SEÇÃO 7 -- ANÁLISE DE CONSULTA COM EXPLAIN
-- ================================================================
-- O que falar na apresentação: "O EXPLAIN nos permite comprovar que o SGBD utilizou 
-- o índice criado para localizar o item de forma otimizada."

EXPLAIN SELECT * FROM estoque WHERE nome_item = 'Cesta Básica 10kg';


-- ================================================================
-- SEÇÃO 8 -- VIEWS (VISÕES)
-- ================================================================

-- View 1: Resumo consolidado do estoque por categoria
-- Explicação: Encapsula a lógica de contagem e soma em uma tabela virtual reutilizável.
CREATE OR REPLACE VIEW vw_resumo_estoque AS
SELECT 
    c.nome_categoria, 
    COUNT(e.id_item) AS itens_cadastrados, 
    SUM(e.quantidade) AS total_unidades
FROM categorias c
LEFT JOIN estoque e ON c.id_categoria = e.id_categoria
GROUP BY c.nome_categoria;

-- Acesso à View 1
SELECT * FROM vw_resumo_estoque;

-- View 2: Relatório de Doadores Ativos
-- Explicação: Oculta a complexidade do JOIN entre doadores e doações.
CREATE OR REPLACE VIEW vw_doadores_ativos AS
SELECT DISTINCT d.id_doador, d.nome, d.email
FROM doadores d
JOIN doacoes doacao ON doacao.id_doador = d.id_doador;

-- Acesso à View 2
SELECT * FROM vw_doadores_ativos;


-- ================================================================
-- SEÇÃO 9 -- FUNCTIONS (FUNÇÕES SQL)
-- ================================================================

DELIMITER $$

-- Função 1: Calcula o valor financeiro total de um lote (quantidade x preço unitário)
CREATE FUNCTION fn_calcular_total_lote(p_qtd INT, p_valor_unit DECIMAL(10,2)) 
RETURNS DECIMAL(10,2)
DETERMINISTIC
BEGIN
    RETURN p_qtd * p_valor_unit;
END$$

-- Função 2: Classifica o nível de criticidade do estoque com base em regras lógicas condicionais (IF/ELSE)
CREATE FUNCTION fn_classificar_estoque(p_qtd INT) 
RETURNS VARCHAR(30)
DETERMINISTIC
BEGIN
    IF p_qtd < 5 THEN
        RETURN 'Estoque Crítico (Baixo)';
    ELSEIF p_qtd BETWEEN 5 AND 20 THEN
        RETURN 'Estoque Moderado';
    ELSE
        RETURN 'Estoque Saudável (Alto)';
    END IF;
END$$

DELIMITER ;

-- Testes de Execução das Funções:
SELECT fn_calcular_total_lote(10, 85.50) AS valor_calculado_lote;

SELECT 
    nome_item, 
    quantidade, 
    fn_classificar_estoque(quantidade) AS status_estoque 
FROM estoque;


-- ================================================================
-- SEÇÃO 10 -- RELATÓRIO AVANÇADO DO SISTEMA
-- ================================================================
-- O que falar na apresentação: "Este relatório combina JOIN, funções de agregação, 
-- GROUP BY, HAVING e ORDER BY para entregar uma visão analítica gerencial completa 
-- das categorias de maior volume físico estocado."

SELECT 
    c.nome_categoria,
    COUNT(e.id_item) AS total_tipos_itens,
    SUM(e.quantidade) AS soma_total_unidades,
    ROUND(AVG(e.quantidade), 2) AS media_unidades_por_item
FROM categorias c
JOIN estoque e ON c.id_categoria = e.id_categoria
WHERE e.quantidade > 0
GROUP BY c.nome_categoria
HAVING SUM(e.quantidade) >= 5
ORDER BY soma_total_unidades DESC;


