-- ================================================================
-- SETUP -- Recriar banco do zero para apresentação limpa
-- ================================================================

DROP DATABASE IF EXISTS ong_estoque_db;

DROP USER IF EXISTS 'admin_ong'@'localhost';
DROP USER IF EXISTS 'estoquista_ong'@'localhost';

-- Criação do banco com suporte a caracteres especiais (UTF-8)
CREATE DATABASE ong_estoque_db CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
USE ong_estoque_db;

-- ----------------------------------------------------------------
-- Tabelas (Modelagem Relacional com UUIDs e Chaves Estrangeiras)
-- ----------------------------------------------------------------

-- Tabela de Doadores: Armazena informações dos colaboradores da ONG.
-- Explicação: Utiliza CHAR(36) com UUID para identificação global única e segura.
CREATE TABLE doadores (
    id_doador      CHAR(36)       PRIMARY KEY DEFAULT (UUID()),
    nome           VARCHAR(150)   NOT NULL,
    email          VARCHAR(100)   NOT NULL UNIQUE,
    telefone       VARCHAR(20),
    created_at     TIMESTAMP      NOT NULL DEFAULT CURRENT_TIMESTAMP
);

-- Tabela de Categorias: Organiza os itens do estoque por setores.
CREATE TABLE categorias (
    id_categoria   INT AUTO_INCREMENT PRIMARY KEY,
    nome_categoria VARCHAR(50)   NOT NULL UNIQUE
);

-- Tabela de Estoque: Controla o volume físico dos mantimentos e insumos.
-- Explicação: Possui chave estrangeira vinculada à categoria com restrição de exclusão (RESTRICT).
CREATE TABLE estoque (
    id_item        CHAR(36)       PRIMARY KEY DEFAULT (UUID()),
    id_categoria   INT            NOT NULL,
    nome_item      VARCHAR(150)   NOT NULL,
    quantidade     INT            NOT NULL DEFAULT 0,
    valor_unitario DECIMAL(10, 2) NOT NULL DEFAULT 0.00,
    CONSTRAINT fk_estoque_categoria FOREIGN KEY (id_categoria) 
        REFERENCES categorias(id_categoria) ON DELETE RESTRICT ON UPDATE CASCADE
);

-- Tabela de Doações: Registra as entradas vinculadas aos doadores.
-- Explicação: Utiliza ON DELETE SET NULL para garantir que, se um doador for removido, o histórico da doação não seja perdido.
CREATE TABLE doacoes (
    id_doacao      CHAR(36)       PRIMARY KEY DEFAULT (UUID()),
    id_doador      CHAR(36),
    data_doacao    DATETIME       NOT NULL DEFAULT CURRENT_TIMESTAMP,
    observacoes    TEXT,
    CONSTRAINT fk_doacao_doador FOREIGN KEY (id_doador) 
        REFERENCES doadores(id_doador) ON DELETE SET NULL ON UPDATE CASCADE
);

-- ----------------------------------------------------------------
-- DCL -- Gerenciamento de Privilégios e Perfis de Acesso
-- ----------------------------------------------------------------
-- Explicação: Aplicamos o princípio do menor privilégio, separando perfis administrativos de operadores de estoque.

CREATE USER IF NOT EXISTS 'admin_ong'@'localhost'       IDENTIFIED BY 'admin_senha_forte';
CREATE USER IF NOT EXISTS 'estoquista_ong'@'localhost'  IDENTIFIED BY 'estoque_123';

-- Administrador possui controle total irrestrito sobre todo o banco de dados
GRANT ALL PRIVILEGES ON ong_estoque_db.* TO 'admin_ong'@'localhost' WITH GRANT OPTION;

-- Perfil Estoquista possui permissão estrita apenas para gerenciar itens e visualizar categorias
GRANT SELECT, INSERT, UPDATE ON ong_estoque_db.estoque     TO 'estoquista_ong'@'localhost';
GRANT SELECT                 ON ong_estoque_db.categorias  TO 'estoquista_ong'@'localhost';

FLUSH PRIVILEGES;


