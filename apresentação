-- ================================================================
-- SETUP -- Recriar banco do zero para apresentação limpa
-- ================================================================

DROP DATABASE IF EXISTS mybank_sql;

DROP USER IF EXISTS 'admin_mybank'@'localhost';
DROP USER IF EXISTS 'financeiro_mybank'@'localhost';
DROP USER IF EXISTS 'analista_bazar'@'localhost';

CREATE DATABASE mybank_sql CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
USE mybank_sql;

-- ----------------------------------------------------------------
-- Tabelas (Modelagem com UUIDs para o MySQL 8.0)
-- ----------------------------------------------------------------

CREATE TABLE doadores (
    id_doador       CHAR(36)      PRIMARY KEY DEFAULT (UUID()),
    nome            VARCHAR(150)  NOT NULL,
    tipo_doador     ENUM('PF', 'PJ') NOT NULL,
    documento       VARCHAR(20)   NOT NULL UNIQUE, 
    telefone        VARCHAR(20),
    email           VARCHAR(100)  NOT NULL UNIQUE,
    senha           VARCHAR(64)   NOT NULL,
    salt            VARCHAR(64)   NOT NULL,
    status_doador   ENUM('Ativo', 'Inativo', 'Suspeito') DEFAULT 'Ativo',
    created_at      TIMESTAMP     NOT NULL DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE categorias_itens (
    id_categoria    INT AUTO_INCREMENT PRIMARY KEY,
    nome_categoria  VARCHAR(50)   NOT NULL UNIQUE
);

CREATE TABLE doacoes (
    id_doacao         CHAR(36)    PRIMARY KEY DEFAULT (UUID()),
    id_doador         CHAR(36),
    data_doacao       DATETIME    NOT NULL DEFAULT CURRENT_TIMESTAMP,
    canal_recebimento ENUM('Presencial', 'PIX', 'Conta Bancária', 'Bazar', 'Cofrinho') NOT NULL,
    tipo_doacao       ENUM('Financeira', 'Material', 'Mista') NOT NULL,
    observacoes       TEXT
);

CREATE TABLE doacoes_financeiras (
    id_financeiro          CHAR(36)       PRIMARY KEY DEFAULT (UUID()),
    id_doacao              CHAR(36)       NOT NULL,
    valor                  DECIMAL(10, 2) NOT NULL,
    comprovante_transacao  VARCHAR(255),
    situacao_compensacao   ENUM('Pendente', 'Compensado', 'Estornado') DEFAULT 'Pendente'
);

CREATE TABLE doacoes_materiais (
    id_material        CHAR(36)       PRIMARY KEY DEFAULT (UUID()),
    id_doacao          CHAR(36)       NOT NULL,
    id_categoria       INT            NOT NULL,
    descricao_item     VARCHAR(150)   NOT NULL,
    quantidade         INT            NOT NULL DEFAULT 1,
    unidade_medida     ENUM('Unidade', 'Kg', 'Pacote', 'Cm') DEFAULT 'Unidade',
    estado_conservacao ENUM('Novo', 'Seminovo', 'Não se aplica') DEFAULT 'Não se aplica',
    destino_item       ENUM('Uso Direto Paciente', 'Bazar', 'Estoque Geral', 'Consumo Interno') NOT NULL
);

-- ----------------------------------------------------------------
-- Procedure de cadastro com hash defensivo em 3 camadas
-- ----------------------------------------------------------------

DELIMITER $$

CREATE PROCEDURE cadastrar_doador(
    IN p_nome        VARCHAR(150),
    IN p_tipo        VARCHAR(2),
    IN p_documento   VARCHAR(20),
    IN p_telefone    VARCHAR(20),
    IN p_email       VARCHAR(100),
    IN p_senha       VARCHAR(255)
)
BEGIN
    DECLARE v_id         CHAR(36);
    DECLARE v_now        TIMESTAMP;
    DECLARE v_salt       VARCHAR(64);
    DECLARE v_senha_hash VARCHAR(64);

    SET v_id  = UUID();
    SET v_now = NOW();

    -- Nível 1: salt único combinando identificador global + timestamp interno
    SET v_salt = SHA2(CONCAT(v_id, v_now), 256);

    -- Nível 2 + 3: Key Stretching com 3 iterações consecutivas de SHA2-256 e injeção do salt
    SET v_senha_hash = SHA2(
                           SHA2(
                               SHA2(CONCAT(p_senha, v_salt), 256),
                               256),
                           256);

    INSERT INTO doadores (id_doador, nome, tipo_doador, documento, telefone, email, senha, salt, created_at)
    VALUES (v_id, p_nome, p_tipo, p_documento, p_telefone, p_email, v_senha_hash, v_salt, v_now);
END$$

DELIMITER ;

-- ----------------------------------------------------------------
-- Constraints & Integridade Referencial
-- ----------------------------------------------------------------

ALTER TABLE doacoes_financeiras ADD CONSTRAINT chk_valor_positivo 
    CHECK (valor > 0);

ALTER TABLE doacoes_materiais ADD CONSTRAINT chk_qtd_positiva 
    CHECK (quantidade > 0);

ALTER TABLE doacoes ADD CONSTRAINT fk_doacao_doador
    FOREIGN KEY (id_doador) REFERENCES doadores(id_doador) ON DELETE SET NULL ON UPDATE CASCADE;

ALTER TABLE doacoes_financeiras ADD CONSTRAINT fk_financeiro_doacao
    FOREIGN KEY (id_doacao) REFERENCES doacoes(id_doacao) ON DELETE CASCADE ON UPDATE CASCADE;

ALTER TABLE doacoes_materiais ADD CONSTRAINT fk_material_doacao
    FOREIGN KEY (id_doacao) REFERENCES doacoes(id_doacao) ON DELETE CASCADE ON UPDATE CASCADE;

ALTER TABLE doacoes_materiais ADD CONSTRAINT fk_material_categoria
    FOREIGN KEY (id_categoria) REFERENCES categorias_itens(id_categoria) ON DELETE RESTRICT ON UPDATE CASCADE;

-- ----------------------------------------------------------------
-- DCL -- Gerenciamento de Privilégios e Perfis de Acesso
-- ----------------------------------------------------------------

CREATE USER IF NOT EXISTS 'admin_mybank'@'localhost'       IDENTIFIED BY 'admin_senha_forte';
CREATE USER IF NOT EXISTS 'financeiro_mybank'@'localhost'  IDENTIFIED BY 'fin_senha_123';
CREATE USER IF NOT EXISTS 'analista_bazar'@'localhost'      IDENTIFIED BY 'bazar_senha_123';

-- Administrador possui controle total irrestrito
GRANT ALL PRIVILEGES ON mybank_sql.* TO 'admin_mybank'@'localhost' WITH GRANT OPTION;

-- Perfil Financeiro manipula transações em dinheiro e visualiza doadores
GRANT SELECT, INSERT, UPDATE ON mybank_sql.doacoes            TO 'financeiro_mybank'@'localhost';
GRANT SELECT, INSERT, UPDATE ON mybank_sql.doacoes_financeiras TO 'financeiro_mybank'@'localhost';
GRANT SELECT                 ON mybank_sql.doadores            TO 'financeiro_mybank'@'localhost';

-- Perfil de Operações do Bazar manipula apenas o controle de itens físicos
GRANT SELECT, INSERT, UPDATE ON mybank_sql.doacoes_materiais   TO 'analista_bazar'@'localhost';
GRANT SELECT                 ON mybank_sql.categorias_itens    TO 'analista_bazar'@'localhost';

-- Aplicação do princípio do menor privilégio (Garantia de Compliance/Segurança)
REVOKE UPDATE ON mybank_sql.doacoes_financeiras FROM 'financeiro_mybank'@'localhost';

FLUSH PRIVILEGES;


