-- ================================================================
-- SEÇÃO 3 -- SEGURANÇA DOS DADOS (DEMONSTRAÇÃO DE CRIPTOGRAFIA)
-- ================================================================

-- Exibição comparativa lado a lado das estratégias de segurança
SELECT 
    nome,
    CASE 
        WHEN salt = '' THEN 'VULNERÁVEL -- SHA2 Sem Salt (Ataque por Dicionário)'
        ELSE 'ALTAMENTE SEGURO -- Salt Randômico + 3x Iterações'
    END AS diagnostico_seguranca,
    LEFT(senha, 20) AS fragmento_hash,
    LEFT(salt, 20) AS fragmento_salt
FROM doadores
ORDER BY salt ASC;


-- ================================================================
-- SEÇÃO 4 -- FUNÇÕES SQL (MANDATÓRIAS)
-- ================================================================

-- ==== Funções de Texto ====
-- UPPER e CONCAT: Geração de etiquetas de identificação de relatórios
SELECT CONCAT('DOADOR: ', UPPER(nome), ' | CONTATO: ', email) AS etiqueta_mala_direta
FROM doadores LIMIT 3;

-- REPLACE: Mascaramento de dados parciais para conformidade com a LGPD
SELECT nome, REPLACE(documento, SUBSTR(documento, 4, 6), '***.***') AS documento_protegido
FROM doadores;

-- ==== Funções Numéricas ====
-- SUM, ROUND, AVG: Extração instantânea de métricas financeiras
SELECT 
    COUNT(*) AS total_transacoes,
    ROUND(SUM(valor), 2) AS receita_total,
    ROUND(AVG(valor), 2) AS ticket_medio_doado
FROM doacoes_financeiras 
WHERE situacao_compensacao = 'Compensado';

-- ==== Funções de Data ====
-- NOW, DATE_FORMAT, DATEDIFF: Análise de tempo decorrido desde transações
SELECT 
    d.id_doacao,
    DATE_FORMAT(d.data_doacao, '%d/%m/%Y às %H:%i') AS data_formatada,
    DATEDIFF(NOW(), d.data_doacao) AS dias_decorridos_ate_hoje
FROM doacoes d;


-- ================================================================
-- SEÇÃO 5 -- RELACIONAMENTO E INTEGRIDADE REFERENCIAL
-- ================================================================
-- Comprovação das regras restrictivas e tratamento automático em cascata.
SELECT 
    CONSTRAINT_NAME AS nome_chave, TABLE_NAME AS tabela_dependente, 
    REFERENCED_TABLE_NAME AS tabela_pai
FROM INFORMATION_SCHEMA.KEY_COLUMN_USAGE
WHERE TABLE_SCHEMA = 'mybank_sql' AND REFERENCED_TABLE_NAME IS NOT NULL;


-- ================================================================
-- SEÇÃO 6 -- CONSULTAS COM JOIN
-- ================================================================

-- INNER JOIN: Cruzamento perfeito mapeando doações ativas de doadores cadastrados
SELECT r.nome AS doador, d.tipo_doacao, d.canal_recebimento, f.valor
FROM doacoes d
INNER JOIN doadores r ON d.id_doador = r.id_doador
INNER JOIN doacoes_financeiras f ON d.id_doacao = f.id_doacao;

-- LEFT JOIN FILTRADO: Rastreamento de doadores inativos que nunca efetuaram ações reais
SELECT dr.nome, dr.email, dr.status_doador
FROM doadores dr
LEFT JOIN doacoes d ON dr.id_doador = d.id_doador
WHERE d.id_doacao IS NULL;


-- ================================================================
-- SEÇÃO 7 -- RELATÓRIOS E INDICADORES (BUSINESS INTELLIGENCE)
-- ================================================================

-- Indicador 1: Consolidação Geral do Painel de B.I (Visão Geral de Caixa e Itens)
SELECT 
    d.canal_recebimento,
    COUNT(d.id_doacao) AS total_ocorrencias,
    COALESCE(SUM(df.valor), 0.00) AS total_arrecadado_moeda
FROM doacoes d
LEFT JOIN doacoes_financeiras df ON d.id_doacao = df.id_doacao
GROUP BY d.canal_recebimento;

-- Indicador 2: Destinação de Materiais Críticos do Estoque
SELECT dm.destino_item, SUM(dm.quantidade) AS volumes_recebidos, c.nome_categoria
FROM doacoes_materiais dm
JOIN categorias_itens c ON dm.id_categoria = c.id_categoria
GROUP BY dm.destino_item, c.nome_categoria;


